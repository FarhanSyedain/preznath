# Copy to .env to override defaults. All keys are prefixed SATARK_.
# SATARK_EAGER_LOAD=true
# SATARK_HF_OFFLINE=true
# SATARK_DEVICE=cpu
# SATARK_LANG_MODEL=papluca/xlm-roberta-base-language-detection
# SATARK_TRANSLATOR_MODEL=Helsinki-NLP/opus-mt-hi-en
# SATARK_SPAM_MODEL=mrm8488/bert-tiny-finetuned-sms-spam-detection
# SATARK_INTENT_MODEL=MoritzLaurer/deberta-v3-xsmall-zeroshot-v1.1-all-33
# SATARK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SATARK_PHISHING_MODELS=["ealvaradob/bert-finetuned-phishing","cybersectony/phishing-email-detection-distilbert_v2.4.1"]
